{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": false,
  "timezone": "Asia/Tokyo",
  "schedule": ["* 0-5 * * 6"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "commitMessageAction": "Bump",
      "commitMessageExtra": "from {{currentVersion}} to {{newVersion}}",
      "commitMessageTopic": "{{depName}}",
      "commitMessageSuffix": ""
    }
  ],
  "group": {
    "commitMessageTopic": "the {{groupName}} group",
    "commitMessageSuffix": "with {{upgrades.length}} updates"
  }
}
